{
  "name": "showpilot",
  "version": "0.2.0",
  "description": "Scripted product demo videos: drives your real app with Playwright, films it with a Screen Studio-style auto-zoom camera, narrates with a local AI voice, and renders with Remotion.",
  "license": "MIT",
  "author": "Vijay Kumar Gowda K (https://github.com/vijaykumargowdakk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijaykumargowdakk/showpilot.git"
  },
  "homepage": "https://github.com/vijaykumargowdakk/showpilot#readme",
  "bugs": "https://github.com/vijaykumargowdakk/showpilot/issues",
  "keywords": [
    "demo video",
    "product video",
    "screen recording",
    "playwright",
    "remotion",
    "kokoro",
    "tts",
    "auto zoom",
    "screencast",
    "subtitles"
  ],
  "type": "module",
  "bin": {
    "showpilot": "bin/showpilot.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!**/__pycache__",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "eslint .",
    "filemap": "node scripts/filemap.mjs",
    "test": "vitest run",
    "check:example": "node bin/showpilot.mjs check tour --project examples/hello && node bin/showpilot.mjs check quick --project examples/hello && node bin/showpilot.mjs check showcase --project examples/showcase",
    "smoke": "node bin/showpilot.mjs help",
    "ci": "npm run typecheck && npm run lint && npm test && npm run check:example && npm run smoke",
    "prepublishOnly": "npm run ci"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.539",
    "@remotion/renderer": "^4.0.539",
    "playwright": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.539",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.9"
  }
}
